# QuoteOn 백엔드 로컬 환경 변수 예시
# 이 파일을 복사해 `.env`로 만들고 값을 채운 뒤 사용하세요.
# 실제 비밀번호·SMTP 계정은 Git에 커밋하지 마세요.

# MySQL (필수)
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# 네이버 메일 SMTP (선택, 견적 이메일 발송 시 필요)
# 값이 없어도 애플리케이션은 기동되며, 메일 발송 API만 실패합니다.
MAIL_HOST=smtp.naver.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_app_password
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
